# Copy this file to .env and fill in your provider's credentials.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-your-api-key
AI_MODEL=gpt-4o-mini

# Aliyun OSS configuration for article cover uploads.
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name
OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret